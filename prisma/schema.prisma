// =====================================================
// SCREENING QUESTIONS
// =====================================================

enum ScreeningQuestionType {
  yes_no
  text
  number
  multiple_choice
}

model ScreeningQuestion {
  id          String                @id @default(uuid()) @db.Uuid
  jobId       String                @map("job_id") @db.Uuid
  question    String                @db.Text
  description String?               @db.Text
  type        ScreeningQuestionType
  options     String[]              @default([]) // untuk multiple_choice
  isRequired  Boolean               @default(true) @map("is_required")
  sortOrder   Int                   @default(0) @map("sort_order")
  createdAt   DateTime              @default(now()) @map("created_at")

  job     Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers ScreeningAnswer[]

  @@index([jobId, sortOrder])
  @@map("screening_questions")
}

model ScreeningAnswer {
  id            String   @id @default(uuid()) @db.Uuid
  questionId    String   @map("question_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  answerText    String?  @map("answer_text") @db.Text
  answerBool    Boolean? @map("answer_bool")
  answerNumber  Int?     @map("answer_number")
  answerChoice  String?  @map("answer_choice")
  createdAt     DateTime @default(now()) @map("created_at")

  question    ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([questionId, applicationId])
  @@index([applicationId])
  @@map("screening_answers")
}

// =====================================================
// AI INTERVIEW (MOCK)
// =====================================================

enum AiInterviewStatus {
  pending // belum dijawab
  completed // sudah dijawab
  expired // lewat batas waktu
  cancelled // dibatalkan recruiter
}

model AiInterview {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @unique @map("application_id") @db.Uuid
  invitedBy     String            @map("invited_by") @db.Uuid
  status        AiInterviewStatus @default(pending)
  invitedAt     DateTime          @default(now()) @map("invited_at")
  completedAt   DateTime?         @map("completed_at")
  expiresAt     DateTime?         @map("expires_at")
  questions     Json // array pertanyaan
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  application Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  inviter     User                @relation(fields: [invitedBy], references: [id])
  answers     AiInterviewAnswer[]

  @@index([status])
  @@map("ai_interviews")
}

model AiInterviewAnswer {
  id            String    @id @default(uuid()) @db.Uuid
  interviewId   String    @map("interview_id") @db.Uuid
  questionIndex Int       @map("question_index")
  question      String    @db.Text
  answer        String?   @db.Text
  answeredAt    DateTime? @map("answered_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  interview AiInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, questionIndex])
  @@index([interviewId])
  @@map("ai_interview_answers")
}

// Tambah di akhir schema.prisma
model TalentInvitation {
  id          String                 @id @default(uuid()) @db.Uuid
  jobId       String                 @map("job_id") @db.Uuid
  studentId   String                 @map("student_id") @db.Uuid
  invitedBy   String                 @map("invited_by") @db.Uuid
  message     String?                @db.Text
  status      TalentInvitationStatus @default(pending)
  respondedAt DateTime?              @map("responded_at")
  createdAt   DateTime               @default(now()) @map("created_at")

  job     Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  inviter User           @relation(fields: [invitedBy], references: [id])

  @@unique([jobId, studentId])
  @@index([studentId, status])
  @@index([jobId, status])
  @@map("talent_invitations")
}

enum TalentInvitationStatus {
  pending
  accepted
  declined
  expired
}

model SavedTalent {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  savedBy   String   @map("saved_by") @db.Uuid
  note      String?  @db.Text
  source    String? // 'talent_match' | 'showcase' | 'applicant' | 'manual'
  createdAt DateTime @default(now()) @map("created_at")

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  saver   User           @relation(fields: [savedBy], references: [id])

  @@unique([companyId, studentId])
  @@index([companyId, createdAt])
  @@index([studentId])
  @@map("saved_talents")
}

model CompanyInvitation {
  id         String                  @id @default(uuid()) @db.Uuid
  companyId  String                  @map("company_id") @db.Uuid
  email      String
  role       CompanyTeamRole         @default(recruiter)
  token      String                  @unique
  invitedBy  String                  @map("invited_by") @db.Uuid
  status     CompanyInvitationStatus @default(pending)
  expiresAt  DateTime                @map("expires_at")
  acceptedAt DateTime?               @map("accepted_at")
  createdAt  DateTime                @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inviter User    @relation(fields: [invitedBy], references: [id])

  @@unique([companyId, email])
  @@index([companyId, status])
  @@index([email])
  @@map("company_invitations")
}

enum CompanyInvitationStatus {
  pending
  accepted
  expired
  revoked
}
