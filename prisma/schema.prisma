generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                    @id @default(uuid()) @db.Uuid
  neonAuthUserId             String                    @unique @map("neon_auth_user_id") @db.Uuid
  email                      String                    @unique
  role                       Role
  fullName                   String?                   @map("full_name")
  phone                      String?
  avatarUrl                  String?                   @map("avatar_url")
  avatarKey                  String?                   @map("avatar_key")
  isActive                   Boolean                   @default(true) @map("is_active")
  lastLoginAt                DateTime?                 @map("last_login_at")
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  deletedAt                  DateTime?                 @map("deleted_at")
  auditLogs                  AuditLog[]
  certificationInstitutionId String?                   @db.Uuid
  jobTitle                   String?                   @map("job_title") @db.VarChar(120)
  notificationPrefs          Json?                     @map("notification_prefs")
  ownedCompany               Company?                  @relation("CompanyOwner")
  companyMembers             CompanyMember[]
  ownedSchool                School?                   @relation("SchoolOwner")
  schoolMembers              SchoolMember[]
  sentInvitations            TalentInvitation[]
  reports                    ContentReport[]           @relation("Reporter")
  conversationParts          ConversationParticipant[]
  sentMessages               Message[]                 @relation("SentMessages")
  notifications              Notification[]
  feedbackGiven              ProfileFeedback[]         @relation("GivenFeedback")
  school                     School?                   @relation(fields: [schoolId], references: [id])
  showcaseComments           ShowcaseComment[]
  showcaseLikes              ShowcaseLike[]
  savedTalents               SavedTalent[]
  aiInterviewsInvited        AiInterview[]
  companyInvitations         CompanyInvitation[]
  ownedInstitution           CertificationInstitution? @relation("InstitutionOwner")
  following                  StudentFollow[]           @relation("Follower")
  studentProfile             StudentProfile?
  schoolId                   String?                   @db.Uuid

  @@index([role])
  @@map("users")
}

model StudentProfile {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @unique @map("user_id") @db.Uuid
  schoolId          String?              @map("school_id") @db.Uuid
  nisn              String?
  headline          String?
  bio               String?
  dateOfBirth       DateTime?            @map("date_of_birth") @db.Date
  gender            Gender?
  address           String?
  city              String?
  province          String?
  coverImageUrl     String?              @map("cover_image_url")
  coverImageKey     String?              @map("cover_image_key")
  profileCompletion Int                  @default(0) @map("profile_completion")
  careerReadiness   Int                  @default(0) @map("career_readiness")
  isOpenToWork      Boolean              @default(true) @map("is_open_to_work")
  isPublic          Boolean              @default(true) @map("is_public")
  followerCount     Int                  @default(0) @map("follower_count")
  followingCount    Int                  @default(0) @map("following_count")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  cvKey             String?              @map("cv_key")
  cvUpdatedAt       DateTime?            @map("cv_updated_at")
  cvUrl             String?              @map("cv_url")
  applications      Application[]
  careerMonitorings CareerMonitoring[]
  certificates      Certificate[]
  invitations       TalentInvitation[]
  feedbacks         ProfileFeedback[]    @relation("ReceivedFeedback")
  savedCompanies    SavedCompany[]
  savedByCompanies  SavedTalent[]
  savedJobs         SavedJob[]
  schoolEnrollments SchoolStudent[]
  showcaseVideos    ShowcaseVideo[]
  achievements      StudentAchievement[]
  educations        StudentEducation[]
  experiences       StudentExperience[]
  followers         StudentFollow[]      @relation("Following")
  portfolios        StudentPortfolio[]
  school            School?              @relation(fields: [schoolId], references: [id])
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            StudentSkill[]

  @@map("student_profiles")
}

model StudentEducation {
  id          String         @id @default(uuid()) @db.Uuid
  studentId   String         @map("student_id") @db.Uuid
  schoolName  String         @map("school_name")
  major       String?
  degree      String?
  startYear   Int?           @map("start_year")
  endYear     Int?           @map("end_year")
  gpa         Decimal?       @db.Decimal(3, 2)
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_educations")
}

model Company {
  id                 String                    @id @default(uuid()) @db.Uuid
  ownerUserId        String?                   @unique @map("owner_user_id") @db.Uuid
  name               String
  slug               String                    @unique
  logoUrl            String?                   @map("logo_url")
  logoKey            String?                   @map("logo_key")
  coverUrl           String?                   @map("cover_url") // ← TAMBAH kalau belum
  coverKey           String?                   @map("cover_key")
  industry           String?
  companySize        CompanySize?              @map("company_size")
  website            String?
  email              String?
  phone              String?
  address            String?
  city               String?
  province           String?
  description        String?
  culture            String?
  benefits           String[]                  @default([])
  foundedYear        Int?                      @map("founded_year")
  verificationStatus VerificationStatus        @default(unverified) @map("verification_status")
  verifiedAt         DateTime?                 @map("verified_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  deletedAt          DateTime?                 @map("deleted_at")
  logoColor          String?                   @map("logo_color")
  tagline            String?
  employeeRange      String?                   @map("employee_range")
  careerMonitorings  CareerMonitoring[]
  featured           Boolean                   @default(false) // <-- TAMBAHKAN BARIS INI
  rating             Float                     @default(0.0)
  reviewCount        Int                       @default(0)
  owner              User?                     @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  members            CompanyMember[]
  skillPreferences   CompanyTalentPreference[]
  verifications      CompanyVerification[]
  industryPartners   IndustryPartner[]
  savedTalents       SavedTalent[]
  invitations        CompanyInvitation[]
  matchingWeights    Json?                     @map("matching_weights") // ← HARUS ADA
  jobs               Job[]
  savedBy            SavedCompany[]
  preferences        TalentPreference?

  // Social
  linkedinUrl  String? @map("linkedin_url") // ← TAMBAH
  instagramUrl String? @map("instagram_url") // ← TAMBAH
  facebookUrl  String? @map("facebook_url") // ← TAMBAH

  @@index([verificationStatus])
  @@map("companies")
}

model CompanyVerification {
  id                      String                   @id @default(uuid()) @db.Uuid
  companyId               String                   @map("company_id") @db.Uuid
  legalDocumentUrl        String?                  @map("legal_document_url")
  legalDocumentKey        String?                  @map("legal_document_key")
  businessRegistrationUrl String?                  @map("business_registration_url")
  businessRegistrationKey String?                  @map("business_registration_key")
  supportingDocs          Json?                    @map("supporting_docs")
  submittedAt             DateTime                 @default(now()) @map("submitted_at")
  reviewedBy              String?                  @map("reviewed_by") @db.Uuid
  reviewedAt              DateTime?                @map("reviewed_at")
  status                  VerificationReviewStatus @default(pending)
  reviewNotes             String?                  @map("review_notes")
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([status])
  @@map("company_verifications")
}

model StudentExperience {
  id             String          @id @default(uuid()) @db.Uuid
  studentId      String          @map("student_id") @db.Uuid
  title          String
  companyName    String?         @map("company_name")
  employmentType EmploymentType? @map("employment_type")
  location       String?
  startDate      DateTime?       @map("start_date") @db.Date
  endDate        DateTime?       @map("end_date") @db.Date
  isCurrent      Boolean         @default(false) @map("is_current")
  description    String?
  createdAt      DateTime        @default(now()) @map("created_at")
  student        StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_experiences")
}

model Skill {
  id           String                    @id @default(uuid()) @db.Uuid
  name         String                    @unique
  category     String?
  createdAt    DateTime                  @default(now()) @map("created_at")
  companyPrefs CompanyTalentPreference[]
  jobSkills    JobSkill[]
  students     StudentSkill[]

  @@map("skills")
}

model StudentSkill {
  id          String         @id @default(uuid()) @db.Uuid
  studentId   String         @map("student_id") @db.Uuid
  skillId     String         @map("skill_id") @db.Uuid
  proficiency Proficiency    @default(intermediate)
  skill       Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
  @@map("student_skills")
}

model StudentAchievement {
  id             String            @id @default(uuid()) @db.Uuid
  studentId      String            @map("student_id") @db.Uuid
  title          String
  issuer         String?
  level          AchievementLevel?
  dateAchieved   DateTime?         @map("date_achieved") @db.Date
  description    String?
  certificateUrl String?           @map("certificate_url")
  certificateKey String?           @map("certificate_key")
  createdAt      DateTime          @default(now()) @map("created_at")
  student        StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_achievements")
}

model StudentPortfolio {
  id           String           @id @default(uuid()) @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  title        String
  description  String?
  projectUrl   String?          @map("project_url")
  thumbnailUrl String?          @map("thumbnail_url")
  thumbnailKey String?          @map("thumbnail_key")
  startDate    DateTime?        @map("start_date") @db.Date
  endDate      DateTime?        @map("end_date") @db.Date
  isPublic     Boolean          @default(true) @map("is_public")
  createdAt    DateTime         @default(now()) @map("created_at")
  media        PortfolioMedia[]
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_portfolios")
}

model PortfolioMedia {
  id          String           @id @default(uuid()) @db.Uuid
  portfolioId String           @map("portfolio_id") @db.Uuid
  mediaType   MediaType        @map("media_type")
  url         String
  key         String
  mimeType    String?          @map("mime_type")
  sizeBytes   BigInt?          @map("size_bytes")
  sortOrder   Int              @default(0) @map("sort_order")
  portfolio   StudentPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("portfolio_media")
}

model ShowcaseVideo {
  id           String            @id @default(uuid()) @db.Uuid
  studentId    String            @map("student_id") @db.Uuid
  title        String
  description  String?
  videoUrl     String            @map("video_url")
  videoKey     String?           @map("video_key")
  videoSource  VideoSource       @default(upload) @map("video_source")
  thumbnailUrl String?           @map("thumbnail_url")
  thumbnailKey String?           @map("thumbnail_key")
  durationSec  Int?              @map("duration_sec")
  category     String?
  skillTags    String[]          @map("skill_tags")
  viewCount    BigInt            @default(0) @map("view_count")
  likeCount    Int               @default(0) @map("like_count")
  commentCount Int               @default(0) @map("comment_count")
  shareCount   Int               @default(0) @map("share_count")
  status       ShowcaseStatus    @default(draft)
  publishedAt  DateTime?         @map("published_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  comments     ShowcaseComment[]
  likes        ShowcaseLike[]
  student      StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([studentId])
  @@index([publishedAt])
  @@map("showcase_videos")
}

model CompanyMember {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @map("company_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  role      CompanyTeamRole @default(recruiter)
  createdAt DateTime        @default(now()) @map("created_at")
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("company_members")
}

model TalentPreference {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @unique @map("company_id") @db.Uuid
  skills         String[]  @default([])
  programs       String[]  @default([])
  locations      String[]  @default([])
  certifications String[]  @default([])
  minExperience  Int?      @map("min_experience")
  maxExperience  Int?      @map("max_experience")
  educationLevel String?   @map("education_level")
  workMode       WorkMode? @map("work_mode")
  preferVerified Boolean   @default(true) @map("prefer_verified")
  preferBnsp     Boolean   @default(true) @map("prefer_bnsp")
  minMatchScore  Int       @default(60) @map("min_match_score")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("talent_preferences")
}

model CompanyTalentPreference {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  skillId    String   @map("skill_id") @db.Uuid
  weight     Int      @default(1)
  isRequired Boolean  @default(false) @map("is_required")
  createdAt  DateTime @default(now()) @map("created_at")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([companyId, skillId])
  @@index([companyId])
  @@index([skillId])
  @@map("company_talent_preferences")
}

model Job {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  createdBy          String?             @map("created_by") @db.Uuid
  title              String
  slug               String              @unique
  description        String?
  requirements       String?
  responsibilities   String?
  employmentType     EmploymentType      @map("employment_type")
  workMode           WorkMode            @map("work_mode")
  experienceLevel    ExperienceLevel?    @map("experience_level")
  location           String?
  city               String?
  benefits           String?
  applicants         Int                 @default(0)
  screeningQuestions ScreeningQuestion[] // ← TAMBAH
  province           String?
  salaryMin          BigInt?             @map("salary_min")
  salaryMax          BigInt?             @map("salary_max")
  salaryCurrency     String              @default("IDR") @map("salary_currency")
  isSalaryVisible    Boolean             @default(false) @map("is_salary_visible")
  quota              Int                 @default(1)
  invitations        TalentInvitation[]
  status             JobStatus           @default(draft)
  publishedAt        DateTime?           @map("published_at")
  expiredAt          DateTime?           @map("expired_at")
  viewCount          BigInt              @default(0) @map("view_count")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  applications       Application[]
  careerMonitorings  CareerMonitoring[]
  skills             JobSkill[]
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  savedBy            SavedJob[]

  @@index([status, publishedAt])
  @@index([companyId])
  @@map("jobs")
}

model JobSkill {
  id         String  @id @default(uuid()) @db.Uuid
  jobId      String  @map("job_id") @db.Uuid
  skillId    String  @map("skill_id") @db.Uuid
  isRequired Boolean @default(true) @map("is_required")
  job        Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@map("job_skills")
}

model Application {
  id                  String                     @id @default(uuid()) @db.Uuid
  jobId               String                     @map("job_id") @db.Uuid
  studentId           String                     @map("student_id") @db.Uuid
  coverLetter         String?                    @map("cover_letter")
  resumeUrl           String?                    @map("resume_url")
  resumeKey           String?                    @map("resume_key")
  status              ApplicationStatus          @default(submitted)
  matchScore          Int?                       @map("match_score")
  matchScoreBreakdown Json?                      @map("match_score_breakdown") // ← HARUS ADA
  matchScoreUpdatedAt DateTime?                  @map("match_score_updated_at") // ← HARUS ADA
  screeningAnswers    ScreeningAnswer[] // ← TAMBAH
  aiInterview         AiInterview?
  appliedAt           DateTime                   @default(now()) @map("applied_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  reviewedAt          DateTime?                  @map("reviewed_at")
  nextStep            String?                    @map("next_step")
  interviewDate       DateTime?                  @map("interview_date")
  recruiterName       String?                    @map("recruiter_name")
  notes               String?
  history             ApplicationStatusHistory[]
  job                 Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student             StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentId])
  @@index([status])
  @@index([studentId, updatedAt])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  status        String
  notes         String?
  changedBy     String?     @map("changed_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

model SavedJob {
  id        String         @id @default(uuid()) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  jobId     String         @map("job_id") @db.Uuid
  savedAt   DateTime       @default(now()) @map("saved_at")
  job       Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, jobId])
  @@map("saved_jobs")
}

model SavedCompany {
  id        String         @id @default(uuid()) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  savedAt   DateTime       @default(now()) @map("saved_at")
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, companyId])
  @@index([studentId, savedAt])
  @@map("saved_companies")
}

model School {
  id                    String       @id @default(uuid()) @db.Uuid
  ownerUserId           String?      @unique @map("owner_user_id") @db.Uuid
  name                  String
  npsn                  String?      @unique
  slug                  String       @unique
  level                 SchoolLevel?
  accreditation         String?
  email                 String?
  phone                 String?
  website               String?
  address               String?
  city                  String?
  province              String?
  logoUrl               String?      @map("logo_url")
  logoKey               String?      @map("logo_key")
  description           String?
  bkkName               String?      @map("bkk_name")
  bkkContact            String?      @map("bkk_contact")
  bkkEmail              String?      @map("bkk_email")
  bkkPhone              String?      @map("bkk_phone")
  schoolCode            String?      @unique @map("school_code")
  activeStudentQuota    Int          @default(200) @map("active_student_quota")
  adminSeatQuota        Int          @default(1) @map("admin_seat_quota")
  subscriptionPlan      String?      @map("subscription_plan")
  subscriptionStatus    String?      @default("trial") @map("subscription_status")
  subscriptionStartedAt DateTime?    @map("subscription_started_at")
  subscriptionExpiresAt DateTime?    @map("subscription_expires_at")
  subscriptionAmount    Int?         @map("subscription_amount")
  paymentMethod         String?      @map("payment_method")
  paymentReference      String?      @map("payment_reference")
  lastPaymentAt         DateTime?    @map("last_payment_at")

  // Token Enrollment
  enrollmentToken String?   @unique @map("enrollment_token")
  tokenActive     Boolean   @default(true) @map("token_active")
  tokenExpiresAt  DateTime? @map("token_expires_at")

  inviteToken  String? @unique @map("invite_token")
  inviteActive Boolean @default(true) @map("invite_active")

  // Verification
  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  owner             User?              @relation("SchoolOwner", fields: [ownerUserId], references: [id])
  members           SchoolMember[]
  programs          SchoolProgram[]
  students          SchoolStudent[]
  studentProfiles   StudentProfile[]
  careerMonitorings CareerMonitoring[]
  industryPartners  IndustryPartner[]
  users             User[]

  @@map("schools")
}

model SchoolMember {
  id        String           @id @default(uuid()) @db.Uuid
  schoolId  String           @map("school_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      SchoolMemberRole @default(member)
  createdAt DateTime         @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@map("school_members")
}

enum SchoolMemberRole {
  owner
  admin
  member
}

model SchoolProgram {
  id          String          @id @default(uuid()) @db.Uuid
  schoolId    String          @map("school_id") @db.Uuid
  name        String
  code        String?
  description String?
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students    SchoolStudent[]

  @@map("school_programs")
}

model SchoolStudent {
  id             String              @id @default(uuid()) @db.Uuid
  schoolId       String              @map("school_id") @db.Uuid
  studentId      String              @map("student_id") @db.Uuid
  programId      String?             @map("program_id") @db.Uuid
  enrollmentYear Int?                @map("enrollment_year")
  graduationYear Int?                @map("graduation_year")
  status         SchoolStudentStatus @default(active)
  program        SchoolProgram?      @relation(fields: [programId], references: [id])
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId])
  @@map("school_students")
}

model IndustryPartner {
  id              String            @id @default(uuid()) @db.Uuid
  schoolId        String            @map("school_id") @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  partnershipType PartnershipType   @default(mou) @map("partnership_type")
  startDate       DateTime?         @map("start_date") @db.Date
  endDate         DateTime?         @map("end_date") @db.Date
  status          PartnershipStatus @default(active)
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, companyId, partnershipType])
  @@map("industry_partners")
}

model CareerMonitoring {
  id            String         @id @default(uuid()) @db.Uuid
  schoolId      String         @map("school_id") @db.Uuid
  studentId     String         @map("student_id") @db.Uuid
  jobId         String?        @map("job_id") @db.Uuid
  companyId     String?        @map("company_id") @db.Uuid
  stage         CareerStage    @default(opportunity)
  notes         String?
  monitoredBy   String?        @map("monitored_by") @db.Uuid
  placementDate DateTime?      @map("placement_date") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  company       Company?       @relation(fields: [companyId], references: [id])
  job           Job?           @relation(fields: [jobId], references: [id])
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
